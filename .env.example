# RoboticsBr - Variaveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.

# Endpoint Formspree para o formulario de contato
# Crie em https://formspree.io/ e cole o ID gerado
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/SEU_FORM_ID

# WhatsApp comercial (apenas digitos, com DDI 55 e DDD)
NEXT_PUBLIC_WHATSAPP_NUMBER=5516992967484

# Google Analytics 4 (opcional, ativado apos consentimento de cookies)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# URL canonica do site (sem barra final)
NEXT_PUBLIC_SITE_URL=https://www.roboticsbr.com
